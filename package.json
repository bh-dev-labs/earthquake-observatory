{
  "name": "earthquake-observatory",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build web --outDir ../cmd/observatory/dist --emptyOutDir",
    "test": "tsx --test web/src/*.test.ts",
    "test:browser": "npm run build && node scripts/workspace-check.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write web/src scripts/*.mjs",
    "format:check": "prettier --check web/src scripts/*.mjs"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "preact": "11.0.2",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/d3-geo": "3.1.1",
    "@types/node": "26.6.5",
    "@types/topojson-client": "3.1.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
